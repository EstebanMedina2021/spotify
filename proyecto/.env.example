# JWT (required in all profiles; fail-fast if missing or < 256 bits)
# Generate one: openssl rand -base64 64
# PowerShell:   [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=<generate-a-random-base64-secret>
JWT_EXPIRATION_MINUTES=15
JWT_ISSUER=playlist-api

# AI provider: mock | gemini | ollama
# In dev, default is mock (no API key required)
AI_PROVIDER=mock
# Spring AI model selector. Must match AI_PROVIDER:
#   mock -> none (default) | gemini -> google-genai | ollama -> ollama
SPRING_AI_MODEL_CHAT=none

# Required only when AI_PROVIDER=gemini
GEMINI_AI_API_KEY=

# Required only when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Spotify (Client Credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# CORS / Frontend origin
FRONTEND_ORIGIN=http://localhost:4200